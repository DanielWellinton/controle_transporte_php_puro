// Totais
$totalAgendados = count($passageiros);
$totalEmbarcados = 0;

foreach ($passageiros as $p) {
    if (!empty($p['pivot_data_hora_saida'])) {
        $totalEmbarcados++;
    }
}
$diferenca = $totalAgendados - $totalEmbarcados;
